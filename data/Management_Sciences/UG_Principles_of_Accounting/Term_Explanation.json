[
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc6bc-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d2c99-716f-11ee-ba96-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "会计是通过专门的方法收集、加工和利用以一定货币单位计量标准来描述经济活动的经济信息，对经济活动进行组织、控制、调节和指导，促使人们比较得失、权衡利弊、讲求经济效益以及协调、维系委托经济责任顺利进行的一种管理活动。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc7b6-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ab6-716f-11ee-a0fb-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计职能"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "指会计作为经济管理工作所具有的功能或能够发挥的作用，基本职能为核算和监督职能，还具有控制经济过程、分析经济效果等职能。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc7f2-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ab7-716f-11ee-8e31-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计核算"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "通过确认、计量、记录、报告，反映企业和行政事业单位已经发生或完成的经济活动，为经营管理提供信息的功能。是会计的首要职能，全部会计管理工作的基础。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc824-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ab8-716f-11ee-b35a-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计监督"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "利用会计信息对企业经济活动进行预测、决策、控制、分析和考评，使其达到预期目标。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc856-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ab9-716f-11ee-9de2-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计目标"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "会计系统运行的出发点和归宿，基本目标是制定经济决策，总体目标是提高经济效益，具体目标是提供决策信息，反映受托责任。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc87e-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7aba-716f-11ee-b770-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计对象"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "特定主体能够用货币表现的经济活动，即会计核算和监督的内容。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc8b0-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7abb-716f-11ee-8006-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计要素"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "是根据交易或事项的经济特征对会计对象进行的最基本的分类，包括资产、负债、所有者权益、收入、费用、利润六大要素。构成会计报表的骨架。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc8d8-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7abc-716f-11ee-8d24-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：资产"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "指过去的交易或者事项形成的、由企业拥有或者控制的、预期会给企业带来经济利益的资源。按其流动性可分为流动资产和非流动资产。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc90a-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7abd-716f-11ee-b0f0-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：负债"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "企业过去的交易或事项形成的、预期会导致经济利益流出企业的现时义务。可分为流动负债和长期负债。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc932-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7abe-716f-11ee-8276-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：所有者权益"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "所有者权益是企业资产扣除负债后由所有者享有的剩余权益，股东价值的账面体现，表面企业归谁所有。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc95a-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7abf-716f-11ee-92cf-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：收入"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "企业在日常活动中形成的、会导致所有者权益增加的、与所有者投入资本无关的经济利益的总流入。增加股东价值的源泉。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc98c-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ac0-716f-11ee-aa00-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：费用"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "费用是企业在日常活动中发生的、会导致所有者权益减少的、与向所有者分配利润无关的经济利益的总流出。增加股东价值的代价。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc9b4-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ac1-716f-11ee-adc4-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：利润"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "企业在一定会计期间的经营成果，全部收入减去全部费用的结果就是利润\n（负数为亏损）。企业经营的会计成果。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bc9dc-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ac2-716f-11ee-88a8-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计恒等式"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "表明各会计要素之间基本关系的恒等式，也称会计平衡公式。资产＝负债+所有者权益，扩展的恒等式为资产＝负债＋所有者权益＋（收入－费用）。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bca0e-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ac3-716f-11ee-8730-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计确认"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "会计确认是指把一个事项作为资产、负债、收入和费用等加以记录并列入财务报表的过程。包括初次确认和再确认。信息变换的关键环节。基本标准有可定义性，可计量性，可靠性，相关性。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bca36-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ac4-716f-11ee-bdfa-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：初次确认"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "对输入会计核算系统的原始经济信息进行的确认。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bca5e-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ac5-716f-11ee-9e90-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：再次确认"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "对会计核算系统输入的经过加工的会计信息进行的确认。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bca90-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ac6-716f-11ee-82bd-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计计量"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "对交易或事项引起的会计要素变动金额加以认定的过程。包括计量单位和计量属性。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bcab8-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ac7-716f-11ee-ad4d-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计假设"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "会计核算的基本前提，组织会计核算工作，需要具备一定的前提条件，包括会计主体，持续经营，会计分期，货币计量。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bcae0-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ac8-716f-11ee-a078-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计主体"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "或称会计实体，是指会计工作为其服务的特定单位或组织。对会计核算空间范围的界定。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bcb08-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ac9-716f-11ee-897e-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：持续经营"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "会计主体的生产经营活动将无限期地持续下去，在可以预见的未来，会计主体不会因清算、解散、倒闭而不复存在。明确了会计核算的时间范围和内容。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bcb3a-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7aca-716f-11ee-8fc2-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计分期"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "是指将会计主体持续不断的经营活动人为地划分为若干连续、长短相同的期间。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bcb62-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7acb-716f-11ee-87e2-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：货币计量"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "会计主体在会计核算过程中采用货币作为主要计量单位（辅之以实物量、劳动工时等计量单位），反映会计主体的生产经营活动。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bcb8a-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7acc-716f-11ee-b85a-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：权责发生制"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "收入和费用的确认按照交易或事项是否影响各会计期间的经营成果和受益情况，确定其归属期。又称应计制或应收应付制。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bcbbc-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7acd-716f-11ee-b422-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：收付实现制"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "收入和费用按照收付时间确定其归属期。又称现金制或实收实付制。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bcbe4-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ace-716f-11ee-a29d-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：会计信息质量特征"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "为使财务报告中所提供的会计信息对投资者等信息使用者决策有用应具备的基本特征。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bcc16-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7acf-716f-11ee-9f7d-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：可靠性"
		},
		{
			"role": "llm",
			"content": null
		}
		],
		"hint": "企业应当以实际发生的交易或事项为依据进行会计处理，如实反映符合确认和计量要求的各项会计要素及其他相关信息，保证会计信息真实可靠、内容完整。"
	},
	{
		"category": "管理学",
		"sub_category": "工商管理类",
		"raw_uuid": "351bcc3e-681a-11ee-9b62-b29c4ac30262",
		"question_uuid": "138d7ad0-716f-11ee-92a0-005056c00008",
		"dialog_uuid": null,
		"llm_name": null,
		"dialog": [
		{
			"role": "user",
			"content": "请对以下名词做出解释：相关性"
		},
		{
			"role": "llm",
			"content": null
		}
		],
